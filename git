# (Neenga ungaloda actual CSV file irundha df = pd.read_csv('your_data.csv') potukalam)
np.random.seed(42)
n_students = 500

gaming_hours = np.random.exponential(scale=2.5, size=n_students).clip(0, 10)
study_hours = np.random.normal(loc=4.5, scale=1.5, size=n_students).clip(1, 10)
sleep_hours = np.random.normal(loc=7.0, scale=1.0, size=n_students).clip(4, 10)

# GPA calculation logic (Negative impact from gaming, positive from studying)
gpa = (
    3.2
    + (0.25 * study_hours)
    - (0.18 * gaming_hours)
    + (0.05 * sleep_hours)
    + np.random.normal(0, 0.25, size=n_students)
).clip(1.5, 4.0)

df = pd.DataFrame(
    {
        "Gaming_Hours": gaming_hours,
        "Study_Hours": study_hours,
        "Sleep_Hours": sleep_hours,
        "GPA": gpa,
    }
)

